{
  "name": "ezt-transform-mcp",
  "version": "1.2.0",
  "description": "MCP server for deterministic EZT-to-Java transformation orchestration",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js --format=cjs --external:child_process --external:fs --external:path --external:os",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.600.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.600.0",
    "@aws-sdk/client-lambda": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-sts": "^3.600.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "archiver": "^7.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  }
}
