//EMPRPTJB JOB (ACCT),'EMP REPORT',CLASS=A,MSGCLASS=X,
//         MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* EMPLOYEE REPORT - READS EMPLOYEE FILE, FILTERS BY DEPARTMENT,
//* PRODUCES SUMMARY REPORT WITH TOTALS
//*-------------------------------------------------------------------
//STEP01   EXEC PGM=EZTPA00
//STEPLIB  DD DSN=SYS1.EZTPLOAD,DISP=SHR
//SYSPRINT DD SYSOUT=*
//EMPFILE  DD DSN=PROD.EMPLOYEE.DATA,DISP=SHR
//RPTOUT   DD DSN=PROD.EMPLOYEE.REPORT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,2),RLSE),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=13300)
//SYSIN    DD *
*
* EMPLOYEE DEPARTMENT REPORT
* READS EMPLOYEE MASTER FILE AND PRODUCES
* DEPARTMENT SUMMARY WITH SALARY TOTALS
*
FILE EMPFILE
  EMP-ID         1   6  A
  EMP-NAME       7  30  A
  EMP-DEPT      37   4  A
  EMP-SALARY    41   8  N 2
  EMP-HIRE-DATE 49   8  A
  EMP-STATUS    57   1  A

W TOTAL-SALARY    10  N 2   VALUE 0
W DEPT-COUNT       5  N 0   VALUE 0
W GRAND-TOTAL     12  N 2   VALUE 0
W GRAND-COUNT      7  N 0   VALUE 0
W PREV-DEPT        4  A     VALUE SPACES
W FIRST-REC        1  A     VALUE 'Y'

JOB INPUT EMPFILE NAME EMP-SORT-RPT
  SORT EMPFILE BY EMP-DEPT EMP-NAME

  IF EMP-STATUS EQ 'A'
    IF FIRST-REC EQ 'Y'
      PREV-DEPT = EMP-DEPT
      FIRST-REC = 'N'
    END-IF

    IF EMP-DEPT NE PREV-DEPT
      PERFORM PRINT-DEPT-TOTAL
      TOTAL-SALARY = 0
      DEPT-COUNT = 0
      PREV-DEPT = EMP-DEPT
    END-IF

    TOTAL-SALARY = TOTAL-SALARY + EMP-SALARY
    DEPT-COUNT = DEPT-COUNT + 1
    GRAND-TOTAL = GRAND-TOTAL + EMP-SALARY
    GRAND-COUNT = GRAND-COUNT + 1

    PRINT RPT-DETAIL
  END-IF

AFTER JOB
  PERFORM PRINT-DEPT-TOTAL
  PRINT RPT-GRAND-TOTAL

PRINT-DEPT-TOTAL. PROC
  PRINT RPT-DEPT-TOTAL
END-PROC

REPORT RPT-DETAIL LINESIZE 133 PAGESIZE 60
  SEQUENCE EMP-DEPT EMP-NAME
  CONTROL EMP-DEPT
  TITLE 01 'EMPLOYEE DEPARTMENT REPORT'
  TITLE 02 'RUN DATE: ' SYSDATE
  HEADING EMP-ID     'EMP ID'
  HEADING EMP-NAME   'EMPLOYEE NAME'
  HEADING EMP-DEPT   'DEPT'
  HEADING EMP-SALARY 'SALARY'
  HEADING EMP-HIRE-DATE 'HIRE DATE'
  LINE 01 EMP-ID EMP-NAME EMP-DEPT EMP-SALARY EMP-HIRE-DATE

REPORT RPT-DEPT-TOTAL
  LINE 01 '  DEPARTMENT: ' PREV-DEPT ' TOTAL: ' +
          TOTAL-SALARY ' COUNT: ' DEPT-COUNT

REPORT RPT-GRAND-TOTAL
  LINE 01 ' '
  LINE 02 '  GRAND TOTAL SALARY: ' GRAND-TOTAL +
          '  TOTAL EMPLOYEES: ' GRAND-COUNT
/*
//
